# Copy to `.env` and fill in the three required values.
#   make env      creates .env from this file
#   make verify   checks that everything is set correctly
# NEVER commit `.env`.

# Rasa Pro Developer Edition licence (a long JWT, one line, no quotes).
RASA_LICENSE=

# LLM for routing + conversation.
OPENAI_API_KEY=

# Speech-to-text (Flux) and text-to-speech (Aura) — one key covers both.
DEEPGRAM_API_KEY=

# Set to 1 to make submit_complaint fail — demonstrates the on_failure lever.
# CIVIC_FORCE_SUBMIT_FAILURE=1

# Optional runtime controls.
# How near an open complaint of the same kind has to be to count as a possible
# duplicate.
# CIVIC_DUPLICATE_RADIUS_METERS=300
# CIVIC_GEOCODE_TIMEOUT=6

# Correcting a misheard place name. This runs only after a plain search has
# found nothing, so it is allowed to be slow — see lib/refine.py.
# CIVIC_REFINE_MODEL=gpt-5-nano
# CIVIC_REFINE_EFFORT=medium
# CIVIC_REFINE_TIMEOUT=15

# The model archive does not contain data/, so tools resolve it from the
# working directory. Set this when the agent is started from somewhere else.
# CIVIC_PROJECT_ROOT=/absolute/path/to/rasa-civic-voice-agent
