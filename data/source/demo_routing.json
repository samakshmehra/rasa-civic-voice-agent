  "location_precision": {
    "notice": "Precision each demo department needs, and how many times to ask before accepting the caller's own description instead. Never blocks filing.",
    "levels": {
      "exact": {
        "attempts_before_approximate": 2,
        "ask_for": "the nearest shop, gate, building or junction"
      },
      "street": {
        "attempts_before_approximate": 1,
