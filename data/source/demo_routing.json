    "by_category": {
      "streetlight": {
        "requires": "exact",
        "reason": "the crew has to find one specific pole"
      },
      "pothole": {
        "requires": "exact",
        "reason": "one road can have several, and the repair is spot-specific"
      },
      "drainage": {
        "requires": "street",
        "reason": "the crew works a drain line rather than a single point"
      },
      "water_supply": {
        "requires": "street",
        "reason": "supply faults affect a whole line or building"
      },
      "garbage": {
        "requires": "street",
        "reason": "a collection round already covers the street"
      },
      "stray_animals": {
        "requires": "area",
        "reason": "animals move, so the catching team works an area"
      }
    }
  }
